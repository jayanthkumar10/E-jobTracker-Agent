# Database Configuration (Postgres)
DATABASE_URL=postgresql://careeros_user:careeros_password@localhost:5432/careeros

# Redis Configuration (Celery Broker)
REDIS_URL=redis://localhost:6379/0

# Security (JWT secret key for user sessions)
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Credentials (OAuth Client ID & Client Secret)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback

# Gemini API Configuration (Google AI Studio Key)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
